<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DissolvingPanel</AssemblyName>
    <RootNamespace>DissolvingPanels</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DissolvingPanel</PackageId>
    <Version>1.1.0</Version>
    <Title>DissolvingPanel</Title>
    <Authors>Dwain Snickles</Authors>
    <Description>WinForms panel that dissolves its contents away and back with 21 PowerPoint-style transitions, an optional slide-in, and a designer smart tag.</Description>
    <PackageTags>winforms;control;animation;transition;dissolve;slide;panel;ui</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DwainSnickles/DissolvingPanel.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/DwainSnickles/DissolvingPanel</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 Dwain Snickles</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- the samples folder has its own project; keep it out of the library build and package -->
    <Compile Remove="samples\**" />
    <None Remove="samples\**" />
    <EmbeddedResource Remove="samples\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
